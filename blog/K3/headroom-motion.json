{
  "$schema": "./presets.schema.json",
  "pack": {
    "name": "headroom-motion",
    "version": "1.0.0",
    "author": "Antigravity Motion Director",
    "intent": "Extracted physical paper-motion, organic harmonic headroom expansion, and hand-inked presets from Headroom Animation.",
    "requires": []
  },

  "easings": {
    "dampedWobble": {
      "intent": "Damped harmonic oscillator matching Headroom's wob(t, 14, 5) curve for natural settling.",
      "curve": {
        "type": "spring",
        "stiffness": 190,
        "damping": 11,
        "mass": 1
      }
    },
    "headroomCeilingLift": {
      "intent": "Organic headroom expansion curve with harmonic resonance giving room to breathe.",
      "curve": [0.2, 1.45, 0.45, 1]
    },
    "paperSnapPop": {
      "intent": "Back overshoot calibrated for pop-up card arrivals matching Headroom's E.back.",
      "curve": {
        "type": "anticipate",
        "amount": 1.9
      }
    },
    "whirlSpiralIn": {
      "intent": "Accelerating logarithmic curve for whirlwind vortex convergence.",
      "curve": [0.65, 0, 0.15, 1]
    },
    "lampPendulum": {
      "intent": "Sine-like swinging pendulum curve for hanging elements and atmospheric lighting.",
      "curve": [0.35, 0, 0.65, 1]
    },
    "drawerGlide": {
      "intent": "Smooth mechanical slide-out ease for filing cabinets and storage drawers.",
      "curve": [0.25, 0.1, 0.25, 1]
    },
    "rumbleDecay": {
      "intent": "Fast exponential shockwave decay curve for workstation vibration and bonks.",
      "curve": [0.05, 0.95, 0.15, 1]
    },
    "paperFloat": {
      "intent": "Gentle aerodynamic floating ease for drifting notes and leaves.",
      "curve": [0.4, 0, 0.2, 1]
    }
  },

  "entry": {
    "headroomCeilingRise": {
      "intent": "Text starts compressed at low ceiling height, then ceiling springs upward allowing phrase to expand and breathe.",
      "duration": 0.9,
      "ease": "headroomCeilingLift",
      "anchor": "baseline",
      "stagger": { "unit": "word", "each": 0.08, "from": "start" },
      "props": {
        "y": [[0, 110], [1, 0]],
        "scaleY": [[0, 0.72], [0.6, 1.08], [1, 1]],
        "lift": [[0, 22], [1, 0]],
        "opacity": [[0, 0], [0.35, 1]]
      }
    },
    "whirlwindAssemble": {
      "intent": "Cards spiral inward along logarithmic vortex curve from scattered flight coordinates into tight lockup.",
      "duration": 0.85,
      "ease": "whirlSpiralIn",
      "anchor": "center",
      "stagger": { "unit": "char", "each": 0.025, "from": "center", "maxTotal": 0.35 },
      "props": {
        "rotZ": [[0, 270], [1, 0]],
        "scale": [[0, 0.25], [1, 1]],
        "z": [[0, -500], [1, 0]],
        "opacity": [[0, 0], [0.25, 1]]
      }
    },
    "paperFwipIn": {
      "intent": "Crisp 3D card pop-up hinged at baseline with realistic paper shading and shadow expansion.",
      "duration": 0.75,
      "ease": "paperSnapPop",
      "anchor": "bottom",
      "stagger": { "unit": "word", "each": 0.07, "from": "start" },
      "props": {
        "rotX": [[0, 88], [1, 0]],
        "shade": [[0, 0.55], [1, 0]],
        "lift": [[0, 24], [1, 0]],
        "opacity": [[0, 0], [0.2, 1]]
      }
    },
    "splitPinHinged": {
      "intent": "Puppet-style card drop swinging freely around top brass split-pin hinge with pendulum settle.",
      "duration": 0.85,
      "ease": "dampedWobble",
      "anchor": "topLeft",
      "stagger": { "unit": "word", "each": 0.09, "from": "start" },
      "props": {
        "rotZ": [[0, -35], [0.45, 12], [0.75, -4], [1, 0]],
        "y": [[0, -80], [1, 0]],
        "opacity": [[0, 0], [0.3, 1]]
      }
    },
    "pushpinStamp": {
      "intent": "Card slams down onto page from camera space and is instantly anchored by a pushpin.",
      "duration": 0.55,
      "ease": "dampedWobble",
      "anchor": "center",
      "stagger": { "unit": "word", "each": 0.08, "from": "start" },
      "props": {
        "scale": [[0, 1.8], [1, 1]],
        "z": [[0, -300], [1, 0]],
        "lift": [[0, 22], [1, 0]],
        "opacity": [[0, 0], [0.2, 1]]
      }
    },
    "filingDrawerSlide": {
      "intent": "Filing drawer slides forward toward camera out of cabinet revealing organized documents.",
      "duration": 0.75,
      "ease": "drawerGlide",
      "anchor": "center",
      "stagger": { "unit": "word", "each": 0.07, "from": "start" },
      "props": {
        "z": [[0, 400], [1, 0]],
        "y": [[0, 60], [1, 0]],
        "shade": [[0, 0.4], [1, 0]],
        "opacity": [[0, 0], [0.25, 1]]
      }
    },
    "inkRibbonTaper": {
      "intent": "Hand-inked pen stroke reveal with normal noise modulation and subtle tracking expansion.",
      "duration": 0.65,
      "ease": "paperFloat",
      "anchor": "left",
      "stagger": { "unit": "char", "each": 0.02, "from": "start", "maxTotal": 0.3 },
      "props": {
        "reveal": [[0, 0], [1, 1]],
        "tracking": [[0, 0.06], [1, 0]],
        "blur": [[0, 6], [0.7, 0]],
        "opacity": [[0, 0], [0.35, 1]]
      }
    },
    "paperFlapBounce": {
      "intent": "Paper flap swings down on top hinge and settles with authentic Headroom step jitter.",
      "duration": 0.8,
      "ease": "dampedWobble",
      "anchor": "top",
      "stagger": { "unit": "word", "each": 0.07, "from": "start" },
      "props": {
        "y": [[0, -220], [1, 0]],
        "rotZ": [[0, 14], [1, 0]],
        "lift": [[0, 14], [1, 0]],
        "opacity": [[0, 0], [0.25, 1]]
      }
    },
    "compressSquash": {
      "intent": "Phrase squashes under physical compression and rebounds with high tension spring settle.",
      "duration": 0.7,
      "ease": "dampedWobble",
      "anchor": "baseline",
      "stagger": { "unit": "word", "each": 0.06, "from": "center" },
      "props": {
        "scaleY": [[0, 0.4], [0.5, 1.25], [1, 1]],
        "scaleX": [[0, 1.3], [0.5, 0.88], [1, 1]],
        "opacity": [[0, 0], [0.3, 1]]
      }
    },
    "folderTabReveal": {
      "intent": "Stepped indexing reveal as if folder divider card is stepped upward.",
      "duration": 0.5,
      "ease": "drawerGlide",
      "anchor": "bottom",
      "stagger": { "unit": "word", "each": 0.05, "from": "start" },
      "props": {
        "y": [[0, 50], [1, 0]],
        "opacity": [[0, 0], [0.3, 1]]
      }
    },
    "tokenMeterFill": {
      "intent": "Metrics scale into position with segmented fill and drop shadow lift.",
      "duration": 0.6,
      "ease": "drawerGlide",
      "anchor": "baseline",
      "stagger": { "unit": "char", "each": 0.02, "from": "start" },
      "props": {
        "scale": [[0, 0.8], [1, 1]],
        "lift": [[0, 12], [1, 0]],
        "opacity": [[0, 0], [0.25, 1]]
      }
    },
    "steamingNote": {
      "intent": "Card floats into scene like warm steam drifting from a workstation mug.",
      "duration": 0.85,
      "ease": "paperFloat",
      "anchor": "center",
      "stagger": { "unit": "word", "each": 0.08, "from": "start" },
      "props": {
        "y": [[0, 65], [1, 0]],
        "rotZ": [[0, -6], [0.5, 4], [1, 0]],
        "opacity": [[0, 0], [0.35, 1]]
      }
    },
    "washiTapeStick": {
      "intent": "Adhesive tape lays down left-to-right holding the phrase securely to the craft board.",
      "duration": 0.55,
      "ease": "paperFloat",
      "anchor": "left",
      "props": {
        "reveal": [[0, 0], [1, 1]],
        "rotZ": [[0, -8], [1, 0]],
        "opacity": [[0, 0], [0.2, 1]]
      }
    },
    "origFilePull": {
      "intent": "Archive document pulled from filing cabinet and rotated slightly toward camera.",
      "duration": 0.8,
      "ease": "drawerGlide",
      "anchor": "center",
      "stagger": { "unit": "word", "each": 0.07, "from": "start" },
      "props": {
        "z": [[0, 280], [1, 0]],
        "rotX": [[0, -25], [1, 0]],
        "lift": [[0, 20], [1, 0]],
        "opacity": [[0, 0], [0.25, 1]]
      }
    }
  },

  "emphasis": {
    "headroomBonk": {
      "intent": "Headroom squish and vertical spring rebound matching the robot bonk impact.",
      "duration": 0.6,
      "ease": "dampedWobble",
      "anchor": "baseline",
      "props": {
        "scaleY": [[0, 1], [0.2, 0.78], [0.5, 1.12], [0.75, 0.95], [1, 1]],
        "y": [[0, 0], [0.2, 14], [0.5, -4], [1, 0]]
      }
    },
    "paperCreaseFlutter": {
      "intent": "Card lifts off page with shadow expansion and flutters along fold crease.",
      "duration": 0.7,
      "ease": "paperFloat",
      "anchor": "bottom",
      "props": {
        "lift": [[0, 0], [0.45, 28], [1, 0]],
        "rotX": [[0, 0], [0.45, -16], [1, 0]]
      }
    },
    "pinTwitch": {
      "intent": "Quick rotational twitch around brass split pin hinge.",
      "duration": 0.5,
      "ease": "dampedWobble",
      "anchor": "topLeft",
      "props": {
        "rotZ": [[0, 0], [0.25, -8], [0.5, 6], [0.75, -3], [1, 0]]
      }
    },
    "tokenBurnPulse": {
      "intent": "Radiant expansion pulse like burning token flame on the meter.",
      "duration": 0.55,
      "ease": "dampedWobble",
      "anchor": "center",
      "props": {
        "scale": [[0, 1], [0.4, 1.18], [1, 1]],
        "lift": [[0, 0], [0.4, 15], [1, 0]]
      }
    },
    "cabinetNudge": {
      "intent": "Drawer forward-and-back inspection nudge in depth.",
      "duration": 0.6,
      "ease": "drawerGlide",
      "anchor": "center",
      "props": {
        "z": [[0, 0], [0.45, -120], [1, 0]],
        "lift": [[0, 0], [0.45, 16], [1, 0]]
      }
    },
    "whirlSpurt": {
      "intent": "Short rotary acceleration pulse as if caught in brief whirlwind.",
      "duration": 0.5,
      "ease": "whirlSpiralIn",
      "anchor": "center",
      "props": {
        "rotZ": [[0, 0], [0.4, 25], [0.7, -10], [1, 0]]
      }
    },
    "shelfRumble": {
      "intent": "Rapid vertical micro-shake mimicking workstation desk vibration.",
      "duration": 0.45,
      "ease": "rumbleDecay",
      "props": {
        "y": [[0, 0], [0.15, -6], [0.35, 6], [0.55, -4], [0.75, 2], [1, 0]]
      }
    },
    "stampThud": {
      "intent": "Heavy compression stamp landing with thud and immediate recovery.",
      "duration": 0.5,
      "ease": "dampedWobble",
      "anchor": "center",
      "props": {
        "lift": [[0, 0], [0.3, 18], [0.6, -2], [1, 0]],
        "scale": [[0, 1], [0.3, 1.08], [1, 1]]
      }
    }
  },

  "exit": {
    "whirlwindVortex": {
      "intent": "Cards get sucked into a swirling vortex spiral into focal center.",
      "duration": 0.6,
      "ease": "whirlSpiralIn",
      "stagger": { "unit": "word", "each": 0.04 },
      "props": {
        "rotZ": [[0, 0], [1, 360]],
        "scale": [[0, 1], [1, 0.05]],
        "z": [[0, 0], [1, 800]],
        "opacity": [[0, 1], [0.8, 1], [1, 0]]
      }
    },
    "drawerRetract": {
      "intent": "Sliding back into filing cabinet with shadow collapse.",
      "duration": 0.48,
      "ease": "drawerGlide",
      "props": {
        "z": [[0, 0], [1, -400]],
        "shade": [[0, 0], [1, 0.6]],
        "opacity": [[0, 1], [0.8, 1], [1, 0]]
      }
    },
    "pinDrop": {
      "intent": "Loses split-pin fastener and falls off page with realistic gravity tilt.",
      "duration": 0.55,
      "ease": "dampedWobble",
      "anchor": "baseline",
      "stagger": { "unit": "char", "each": 0.015, "from": "random", "maxTotal": 0.25 },
      "props": {
        "y": [[0, 0], [1, 550]],
        "rotZ": [[0, 0], [1, 28]],
        "opacity": [[0, 1], [0.7, 1], [1, 0]]
      }
    },
    "paperFlutterFly": {
      "intent": "Flies upward and away like paper caught in draft.",
      "duration": 0.58,
      "ease": "paperFloat",
      "props": {
        "y": [[0, 0], [1, -420]],
        "x": [[0, 0], [1, 180]],
        "rotZ": [[0, 0], [1, -22]],
        "opacity": [[0, 1], [1, 0]]
      }
    },
    "ceilingSquishOut": {
      "intent": "Ceiling descends and squashes phrase flat into baseline.",
      "duration": 0.45,
      "ease": "dampedWobble",
      "anchor": "baseline",
      "props": {
        "scaleY": [[0, 1], [1, 0.1]],
        "y": [[0, 0], [1, 90]],
        "opacity": [[0, 1], [0.7, 1], [1, 0]]
      }
    },
    "tapePeel": {
      "intent": "Washi tape unpeels from right to left.",
      "duration": 0.4,
      "ease": "paperFloat",
      "anchor": "right",
      "props": {
        "reveal": [[0, 1], [1, 0]],
        "rotZ": [[0, 0], [1, 10]]
      }
    },
    "flameVanish": {
      "intent": "Dissipates upward with burning token flame flickers.",
      "duration": 0.5,
      "ease": "paperFloat",
      "props": {
        "y": [[0, 0], [1, -280]],
        "blur": [[0, 0], [1, 8]],
        "opacity": [[0, 1], [1, 0]]
      }
    },
    "irisShrink": {
      "intent": "Contracts into circular iris aperture.",
      "duration": 0.45,
      "ease": "whirlSpiralIn",
      "props": {
        "scale": [[0, 1], [1, 0.1]],
        "blur": [[0, 0], [1, 5]],
        "opacity": [[0, 1], [1, 0]]
      }
    }
  },

  "loop": {
    "headroomLampSway": {
      "intent": "Gentle swinging lamp pendulum oscillation giving ambient room life.",
      "period": 3.2,
      "ease": "lampPendulum",
      "fadeIn": 0.5,
      "props": {
        "rotZ": [[0, 0], [0.5, 2.2], [1, 0]]
      }
    },
    "paperBoilWiggle": {
      "intent": "Authentic 12 fps stop-motion jitter from Headroom's boil frame index.",
      "period": 0.5,
      "ease": "hold",
      "phase": "random",
      "fadeIn": 0.2,
      "props": {
        "rotZ": [[0, 0], [0.33, 0.7], [0.66, -0.6], [1, 0]],
        "y": [[0, 0], [0.33, -0.9], [0.66, 0.7], [1, 0]]
      }
    },
    "whirlHover": {
      "intent": "Gentle levitating hover with subtle sine wave oscillation.",
      "period": 2.4,
      "ease": "paperFloat",
      "fadeIn": 0.4,
      "props": {
        "y": [[0, 0], [0.5, -8], [1, 0]],
        "rotZ": [[0, 0], [0.5, 1.4], [1, 0]]
      }
    },
    "plantBreeze": {
      "intent": "Organic swaying curve like the Headroom potted plant.",
      "period": 3.5,
      "ease": "lampPendulum",
      "fadeIn": 0.6,
      "props": {
        "rotZ": [[0, 0], [0.5, -3.2], [1, 0]]
      }
    },
    "tokenBlink": {
      "intent": "Subtle indicator blink on active token and machine status.",
      "period": 1.8,
      "ease": "paperFloat",
      "fadeIn": 0.3,
      "props": {
        "opacity": [[0, 1], [0.5, 0.75], [1, 1]]
      }
    },
    "folderHover": {
      "intent": "Suspended folder tab hover in 3D filing space.",
      "period": 2.6,
      "ease": "drawerGlide",
      "fadeIn": 0.4,
      "props": {
        "z": [[0, 0], [0.5, -14], [1, 0]]
      }
    }
  },

  "camera": {
    "headroomCeilingTrack": {
      "intent": "Camera pulls back as room expands upward, widening the field of view for breathing room.",
      "duration": 1.5,
      "ease": "headroomCeilingLift",
      "from": { "zoom": 1.6, "rotX": 10 },
      "framing": { "rotX": -6, "zoom": 1.05 },
      "drift": { "dist": -80 },
      "motionBlur": 0.5
    },
    "rumbleCameraShake": {
      "intent": "Exponential decay camera shake mimicking Headroom's bonk impact.",
      "duration": 0.65,
      "ease": "rumbleDecay",
      "from": { "tx": 25, "ty": -18 },
      "framing": { "zoom": 1.1 },
      "drift": { "rotZ": 0.5 },
      "motionBlur": 1.2
    },
    "deskInspectionPush": {
      "intent": "45-degree angled push toward workstation desk setup.",
      "duration": 1.2,
      "ease": "drawerGlide",
      "from": { "zoom": 1.5, "rotY": 18 },
      "framing": { "rotY": 6, "rotX": -4, "zoom": 1.12 },
      "drift": { "dist": -50 },
      "motionBlur": 0.4
    },
    "filingCabinetRack": {
      "intent": "Camera tracks across to the filing cabinet with rack focus.",
      "duration": 1.3,
      "ease": "drawerGlide",
      "rackFocus": { "delay": 0.35, "aperture": 3.0 },
      "from": { "tx": -500 },
      "framing": { "rotY": -8, "zoom": 1.14 },
      "motionBlur": 0.5
    },
    "whirlwindOrbit": {
      "intent": "Camera orbits while the whirlwind pulls scattered elements into order.",
      "duration": 1.6,
      "ease": "whirlSpiralIn",
      "from": { "rotY": 35 },
      "props": { "rotY": [[0, 0], [0.5, -20], [1, 0]] },
      "framing": { "rotY": 8, "zoom": 1.1 },
      "motionBlur": 0.8
    },
    "meterFocusZoom": {
      "intent": "Crash zoom onto token fuel gauge.",
      "duration": 0.5,
      "ease": "rumbleDecay",
      "from": { "zoom": 2.4 },
      "framing": { "zoom": 1.08 },
      "motionBlur": 1.1
    },
    "hangingLampSway": {
      "intent": "Subtle camera tilt tracking hanging lamp oscillation.",
      "duration": 1.8,
      "ease": "lampPendulum",
      "framing": { "rotZ": -3, "rotX": 4, "zoom": 1.1 },
      "motionBlur": 0.3
    },
    "workshopOverview": {
      "intent": "Broad diorama view of entire pop-up room.",
      "duration": 2.0,
      "ease": "drawerGlide",
      "framing": { "rotY": -6, "rotX": 10, "zoom": 0.94 },
      "drift": { "dist": 120 },
      "motionBlur": 0.4
    }
  },

  "staging": {
    "filingCabinetStack": {
      "intent": "Isometric cabinet drawer staging where subsequent shots slide forward in z-depth.",
      "type": "linear",
      "step": { "z": 900, "y": 80 },
      "jitter": { "x": 60, "rotZ": 3 }
    },
    "whirlwindConvergence": {
      "intent": "Radial spiral staging converging on center.",
      "type": "ring",
      "radius": 1800,
      "angleStep": 60,
      "facing": 1,
      "step": { "y": -120 }
    },
    "roomPerspective": {
      "intent": "3D room coordinates with vanishing point [960, 560].",
      "type": "linear",
      "step": { "x": 1100, "z": -350, "rotY": -16 },
      "alternate": ["x", "rotY"]
    },
    "headroomCascade": {
      "intent": "Stepped descending cascade for logical processes and breathing room.",
      "type": "linear",
      "step": { "x": 650, "y": -420, "z": -120 },
      "jitter": { "y": 40 }
    },
    "workshopDesk": {
      "intent": "Horizontal layout across creator workstation table.",
      "type": "linear",
      "step": { "x": 800, "y": 120 }
    },
    "dualDeskDuel": {
      "intent": "Split desk placement for comparison and debate.",
      "type": "linear",
      "step": { "x": 1500, "rotY": 14 },
      "alternate": ["x", "rotY"]
    }
  },

  "layouts": {
    "pinnedCards": {
      "intent": "Paper cards attached with brass split pins and tape.",
      "mode": "center",
      "width": 0.72,
      "maxLines": 2,
      "paper": {
        "strip": "word",
        "pad": [0.1, 0.14],
        "torn": 0.6,
        "entry": "stripDrop",
        "lift": 3
      }
    },
    "filingTab": {
      "intent": "Index tab layout like folder dividers in the Headroom cabinet.",
      "mode": "lockup",
      "width": 0.74,
      "maxLines": 3,
      "lineHeight": 1.08,
      "paper": {
        "strip": "line",
        "pad": [0.08, 0.12],
        "torn": 0.5,
        "entry": "stripWipe",
        "lift": 2
      }
    },
    "paperCutoutHeadline": {
      "intent": "Heavy torn paper headline lockup.",
      "mode": "lockup",
      "width": 0.8,
      "maxLines": 2,
      "lineHeight": 0.96
    },
    "headroomSpacious": {
      "intent": "Spacious layout with generous vertical clearance.",
      "mode": "center",
      "width": 0.78,
      "maxLines": 2,
      "lineHeight": 1.25
    },
    "tokenDashboard": {
      "intent": "Dashboard style alignment for metric indicators.",
      "mode": "left",
      "width": 0.7,
      "maxLines": 3,
      "lineHeight": 1.1
    },
    "handwrittenPostit": {
      "intent": "Handwritten note card for supporting commentary.",
      "mode": "left",
      "width": 0.65,
      "maxLines": 3,
      "lineHeight": 1.1,
      "style": { "role": "hand" }
    }
  },

  "supplements": {
    "brassPin": {
      "intent": "Authentic brass split pin fastener holding card corner.",
      "kind": "brassPin",
      "delay": 0.05,
      "duration": 0.45,
      "ease": "dampedWobble",
      "style": {
        "color": "@accent",
        "radius": 14,
        "at": "topLeft"
      }
    },
    "pushPin": {
      "intent": "Colored 3D pushpin anchoring card with shadow depth.",
      "kind": "pushPin",
      "delay": 0.06,
      "duration": 0.5,
      "ease": "dampedWobble",
      "style": {
        "color": "@accent3",
        "radius": 15
      }
    },
    "washiTape": {
      "intent": "Translucent textured tape strip over card edge.",
      "kind": "washiTape",
      "delay": 0.02,
      "duration": 0.45,
      "ease": "swipe",
      "style": {
        "color": "@strip[1]",
        "tilt": -5
      }
    },
    "folderTab": {
      "intent": "Filing folder tab with indicator label.",
      "kind": "folderTab",
      "delay": 0.08,
