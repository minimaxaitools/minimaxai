{
  "$schema": "./presets.schema.json",
  "pack": {
    "name": "advance-motion-pro",
    "version": "1.0.0",
    "author": "Antigravity Motion Director",
    "intent": "Professional After Effects-grade motion design preset pack featuring cinematic, editorial, and documentary presets.",
    "requires": []
  },

  "easings": {
    "cinematicOut": {
      "intent": "Premium decelerating curve with extended resting tail for high-status hero elements.",
      "curve": [0.19, 1, 0.22, 1]
    },
    "editorialSnap": {
      "intent": "Immediate velocity burst settling instantly into position for clean news/infographic text.",
      "curve": [0.05, 0.9, 0.15, 1]
    },
    "heavyLand": {
      "intent": "Controlled gravitational impact with slight overshoot for authoritative titles and monuments.",
      "curve": [0.25, 1.35, 0.45, 1]
    },
    "gentleSettle": {
      "intent": "Smooth balanced S-curve for secondary labels and subtle narrative shifts.",
      "curve": [0.25, 0.1, 0.25, 1]
    },
    "snapBack": {
      "intent": "Restrained anticipation pullback before rapid forward launch.",
      "curve": {
        "type": "anticipate",
        "amount": 1.25
      }
    },
    "springPrecision": {
      "intent": "High-tension physical spring with crisp dampening and no cartoon wobble.",
      "curve": {
        "type": "spring",
        "stiffness": 310,
        "damping": 22,
        "mass": 1
      }
    },
    "elasticPunch": {
      "intent": "Quick tactile elasticity snap for quantitative numbers and verification badges.",
      "curve": {
        "type": "elastic",
        "amplitude": 0.8,
        "period": 0.28
      }
    },
    "documentaryDrift": {
      "intent": "Sustained, slow-traveling ease for atmospheric camera glides and panoramas.",
      "curve": [0.4, 0, 0.2, 1]
    }
  },

  "entry": {
    "cinematicRise": {
      "intent": "The phrase ascends with dignified tracking contraction and subtle de-blur into a razor-sharp composition.",
      "duration": 0.95,
      "ease": "cinematicOut",
      "anchor": "baseline",
      "stagger": { "unit": "char", "each": 0.025, "from": "center", "maxTotal": 0.35 },
      "props": {
        "y": [[0, 80], [1, 0]],
        "tracking": [[0, 0.08], [1, 0]],
        "blur": [[0, 8], [0.7, 0]],
        "opacity": [[0, 0], [0.35, 1]]
      }
    },
    "editorialTrackIn": {
      "intent": "Rapid broadcast arrival from the side with tight tracking expanding seamlessly into justified alignment.",
      "duration": 0.65,
      "ease": "editorialSnap",
      "anchor": "left",
      "stagger": { "unit": "word", "each": 0.06, "from": "start" },
      "props": {
        "x": [[0, 180], [1, 0]],
        "tracking": [[0, -0.05], [1, 0]],
        "opacity": [[0, 0], [0.25, 1]]
      }
    },
    "depthFocus": {
      "intent": "Text emerges from deep z-space toward camera, clearing optical blur as it locks into baseline focus.",
      "duration": 0.85,
      "ease": "cinematicOut",
      "anchor": "center",
      "stagger": { "unit": "char", "each": 0.02, "from": "center", "maxTotal": 0.3 },
      "props": {
        "z": [[0, 1100], [1, 0]],
        "blur": [[0, 16], [0.75, 0]],
        "scale": [[0, 1.25], [1, 1]],
        "opacity": [[0, 0], [0.3, 1]]
      }
    },
    "magneticSnap": {
      "intent": "Words drop sharply from above and lock with controlled vertical compression like magnetized type.",
      "duration": 0.55,
      "ease": "editorialSnap",
      "anchor": "baseline",
      "stagger": { "unit": "word", "each": 0.07, "from": "start" },
      "props": {
        "y": [[0, -90], [1, 0]],
        "scaleY": [[0, 1.3], [0.5, 0.92], [1, 1]],
        "opacity": [[0, 0], [0.25, 1]]
      }
    },
    "dimensionalTurn": {
      "intent": "Whole phrase turns into perspective from an 85 degree 3D rotation, shedding shadow as it faces camera.",
      "duration": 0.8,
      "ease": "cinematicOut",
      "anchor": "center",
      "stagger": { "unit": "word", "each": 0.08, "from": "start" },
      "props": {
        "rotY": [[0, 85], [1, 0]],
        "z": [[0, -240], [1, 0]],
        "shade": [[0, 0.45], [1, 0]],
        "opacity": [[0, 0], [0.2, 1]]
      }
    },
    "inkBleedReveal": {
      "intent": "Authoritative letters bloom outward from center through soft optical ink dispersion before sharpening.",
      "duration": 0.9,
      "ease": "cinematicOut",
      "anchor": "center",
      "stagger": { "unit": "char", "each": 0.03, "from": "center", "maxTotal": 0.35 },
      "props": {
        "blur": [[0, 14], [0.75, 0]],
        "scale": [[0, 1.4], [1, 1]],
        "opacity": [[0, 0], [0.35, 1]]
      }
    },
    "baselineLock": {
      "intent": "Clean upward editorial glide that establishes immediate readability with baseline precision.",
      "duration": 0.6,
      "ease": "editorialSnap",
      "anchor": "baseline",
      "stagger": { "unit": "char", "each": 0.02, "from": "start", "maxTotal": 0.3 },
      "props": {
        "y": [[0, 45], [1, 0]],
        "opacity": [[0, 0], [0.3, 1]]
      }
    },
    "heroDropSettle": {
      "intent": "Weighty descent from upper frame landing with controlled gravitational impact and slight shadow lift.",
      "duration": 0.85,
      "ease": "heavyLand",
      "anchor": "baseline",
      "stagger": { "unit": "word", "each": 0.09, "from": "start" },
      "props": {
        "y": [[0, -320], [1, 0]],
        "rotZ": [[0, 6], [1, 0]],
        "lift": [[0, 16], [1, 0]],
        "opacity": [[0, 0], [0.25, 1]]
      }
    },
    "splitExpand": {
      "intent": "Letters expand symmetrically from center outward with tracking release and horizontal scale normalization.",
      "duration": 0.75,
      "ease": "cinematicOut",
      "anchor": "center",
      "stagger": { "unit": "char", "each": 0.022, "from": "edges", "maxTotal": 0.32 },
      "props": {
        "tracking": [[0, -0.12], [1, 0]],
        "scaleX": [[0, 0.6], [1, 1]],
        "opacity": [[0, 0], [0.3, 1]]
      }
    },
    "archivalStamp": {
      "intent": "Authoritative downward compression like a historical seal stamped onto parchment.",
      "duration": 0.5,
      "ease": "springPrecision",
      "anchor": "center",
      "stagger": { "unit": "word", "each": 0.12, "from": "start" },
      "props": {
        "scale": [[0, 2.2], [1, 1]],
        "rotZ": [[0, -5], [1, 0]],
        "blur": [[0, 4], [0.6, 0]],
        "lift": [[0, 20], [1, 0]],
        "opacity": [[0, 0], [0.15, 1]]
      }
    },
    "perspectiveUnfold": {
      "intent": "Lines unfold downward along a top horizontal hinge with subtle paper shading settling to flat.",
      "duration": 0.85,
      "ease": "cinematicOut",
      "anchor": "top",
      "stagger": { "unit": "word", "each": 0.08, "from": "start" },
      "props": {
        "rotX": [[0, -85], [1, 0]],
        "shade": [[0, 0.5], [1, 0]],
        "lift": [[0, 12], [1, 0]],
        "opacity": [[0, 0], [0.2, 1]]
      }
    },
    "fastHorizonSlide": {
      "intent": "Horizontal velocity sweep from screen left with speed-skew that squares up instantly on arrival.",
      "duration": 0.58,
      "ease": "editorialSnap",
      "anchor": "left",
      "stagger": { "unit": "word", "each": 0.06, "from": "start" },
      "props": {
        "x": [[0, -450], [1, 0]],
        "skewX": [[0, 18], [1, 0]],
        "blur": [[0, 10], [0.7, 0]],
        "opacity": [[0, 0], [0.22, 1]]
      }
    },
    "softOvershootPop": {
      "intent": "Gentle upward scale arrival settling with restrained spring tension for educational explanations.",
      "duration": 0.7,
      "ease": "springPrecision",
      "anchor": "baseline",
      "stagger": { "unit": "char", "each": 0.024, "from": "start", "maxTotal": 0.34 },
      "props": {
        "scale": [[0, 0.7], [1, 1]],
        "y": [[0, 40], [1, 0]],
        "opacity": [[0, 0], [0.25, 1]]
      }
    },
    "cameraCatch": {
      "intent": "Words shoot past camera position and decelerate gracefully onto resting plane.",
      "duration": 0.75,
      "ease": "cinematicOut",
      "anchor": "center",
      "stagger": { "unit": "char", "each": 0.02, "from": "center", "maxTotal": 0.3 },
      "props": {
        "z": [[0, -800], [1, 0]],
        "blur": [[0, 12], [0.75, 0]],
        "opacity": [[0, 0], [0.28, 1]]
      }
    },
    "microStaggerFade": {
      "intent": "Minimalist editorial typography reveal stepping sequentially without dramatic scale changes.",
      "duration": 0.45,
      "ease": "editorialSnap",
      "anchor": "baseline",
      "stagger": { "unit": "char", "each": 0.02, "from": "start", "maxTotal": 0.3 },
      "props": {
        "y": [[0, 25], [1, 0]],
        "opacity": [[0, 0], [0.35, 1]]
      }
    },
    "stripSlideLock": {
      "intent": "Paper strip backing wipes open left-to-right while typography locks into alignment.",
      "duration": 0.55,
      "ease": "editorialSnap",
      "anchor": "left",
      "props": {
        "reveal": [[0, 0], [1, 1]],
        "x": [[0, -30], [1, 0]]
      }
    }
  },

  "emphasis": {
    "microPunch": {
      "intent": "Restrained scale pulse with anchored baseline to emphasize key terms without layout disruption.",
      "duration": 0.45,
      "ease": "editorialSnap",
      "anchor": "baseline",
      "props": {
        "scale": [[0, 1], [0.4, 1.12], [1, 1]]
      }
    },
    "trackingExpansion": {
      "intent": "Subtle letter-spacing breath that draws visual weight into a hero concept before settling back.",
      "duration": 0.75,
      "ease": "cinematicOut",
      "anchor": "center",
      "props": {
        "tracking": [[0, 0], [0.45, 0.06], [1, 0]],
        "scale": [[0, 1], [0.45, 1.04], [1, 1]]
      }
    },
    "focalDepthPush": {
      "intent": "Word pushes into camera space with elevated shadow lift before settling cleanly back into the plane.",
      "duration": 0.7,
      "ease": "cinematicOut",
      "anchor": "center",
      "props": {
        "z": [[0, 0], [0.45, -160], [1, 0]],
        "lift": [[0, 0], [0.45, 18], [1, 0]],
        "scale": [[0, 1], [0.45, 1.06], [1, 1]]
      }
    },
    "subtleTilt": {
      "intent": "Analytical angular tilt that accentuates an inquisitive or investigative tone.",
      "duration": 0.6,
      "ease": "gentleSettle",
      "anchor": "center",
      "props": {
        "rotZ": [[0, 0], [0.3, 4.5], [0.65, -2], [1, 0]]
      }
    },
    "attentionNudge": {
      "intent": "Crisp horizontal double-nudge to highlight contrasting evidence or data shifts.",
      "duration": 0.45,
      "ease": "editorialSnap",
      "props": {
        "x": [[0, 0], [0.2, 8], [0.45, -6], [0.7, 3], [1, 0]]
      }
    },
    "evidenceLift": {
      "intent": "Target word peels up off page with amplified drop-shadow and slight pitch tilt.",
      "duration": 0.65,
      "ease": "cinematicOut",
      "anchor": "baseline",
      "props": {
        "lift": [[0, 0], [0.45, 24], [1, 0]],
        "rotX": [[0, 0], [0.45, -10], [1, 0]]
      }
    },
    "statGlowPulse": {
      "intent": "Quantitative punch on numbers: crisp scale jump and recovery without blur.",
      "duration": 0.5,
      "ease": "elasticPunch",
      "anchor": "center",
      "props": {
        "scale": [[0, 1], [0.35, 1.15], [0.7, 0.98], [1, 1]]
      }
    },
    "cardFlipPrompt": {
      "intent": "Full 360-degree card revolution in 3D perspective to present a transformed idea.",
      "duration": 0.8,
      "ease": "cinematicOut",
      "anchor": "center",
      "props": {
        "rotY": [[0, 0], [1, 360]],
        "shade": [[0, 0], [0.5, 0.35], [1, 0]]
      }
    },
    "softAnticipate": {
      "intent": "Word compresses backward slightly before rebounding into resting position.",
      "duration": 0.55,
      "ease": "springPrecision",
      "anchor": "center",
      "props": {
        "scale": [[0, 1], [0.25, 0.94], [0.6, 1.05], [1, 1]]
      }
    },
    "warningTremor": {
      "intent": "Horizontal micro-tremor to signal danger, exceptions, or common academic errors.",
      "duration": 0.4,
      "ease": "editorialSnap",
      "props": {
        "x": [[0, 0], [0.15, -7], [0.35, 7], [0.6, -4], [0.8, 2], [1, 0]]
      }
    }
  },

  "exit": {
    "cinematicFadeThrough": {
      "intent": "Phrase recedes deep into camera background with soft defocus while new content takes precedence.",
      "duration": 0.65,
      "ease": "cinematicOut",
      "stagger": { "unit": "word", "each": 0.04 },
      "props": {
        "z": [[0, 0], [1, 900]],
        "opacity": [[0, 1], [1, 0]],
        "blur": [[0, 0], [1, 8]]
      }
    },
    "editorialSlideLeft": {
      "intent": "Fast lateral exit to screen left with slight velocity skew.",
      "duration": 0.45,
      "ease": "editorialSnap",
      "stagger": { "unit": "word", "each": 0.05 },
      "props": {
        "x": [[0, 0], [1, -600]],
        "skewX": [[0, 0], [1, -12]],
        "opacity": [[0, 1], [0.8, 1], [1, 0]]
      }
    },
    "archivalDrop": {
      "intent": "Letters unglue and drop naturally off the baseline plane.",
      "duration": 0.55,
      "ease": "heavyLand",
      "anchor": "baseline",
      "stagger": { "unit": "char", "each": 0.015, "from": "random", "maxTotal": 0.25 },
      "props": {
        "y": [[0, 0], [1, 480]],
        "rotZ": [[0, 0], [1, 14]],
        "opacity": [[0, 1], [0.75, 1], [1, 0]]
      }
    },
    "perspectiveFoldDown": {
      "intent": "Text rotates backward flat into the page on baseline hinge with darkening shadow.",
      "duration": 0.5,
      "ease": "editorialSnap",
      "anchor": "bottom",
      "props": {
        "rotX": [[0, 0], [1, 90]],
        "shade": [[0, 0], [1, 0.6]],
        "opacity": [[0, 1], [0.85, 1], [1, 0]]
      }
    },
    "dissolveTracking": {
      "intent": "Letters track outward while dissolving into air for contemplative conclusions.",
      "duration": 0.6,
      "ease": "cinematicOut",
      "props": {
        "tracking": [[0, 0], [1, 0.15]],
        "opacity": [[0, 1], [1, 0]],
        "blur": [[0, 0], [1, 6]]
      }
    },
    "horizonSnapRight": {
      "intent": "Rapid wipe off-stage to screen right maintaining clean horizon.",
      "duration": 0.45,
      "ease": "editorialSnap",
      "props": {
        "x": [[0, 0], [1, 750]],
        "opacity": [[0, 1], [0.8, 1], [1, 0]]
      }
    },
    "cameraPassOver": {
      "intent": "Shot slips beneath the bottom camera frame as we advance across the document.",
      "duration": 0.55,
      "ease": "cinematicOut",
      "props": {
        "y": [[0, 0], [1, 350]],
        "z": [[0, 0], [1, 400]],
        "rotX": [[0, 0], [1, -25]],
        "opacity": [[0, 1], [1, 0]]
      }
    },
    "contractShrink": {
      "intent": "Direct scale contraction into the focal center point.",
      "duration": 0.4,
      "ease": "editorialSnap",
      "props": {
        "scale": [[0, 1], [1, 0.2]],
        "opacity": [[0, 1], [1, 0]]
      }
    },
    "stripRollOut": {
      "intent": "Paper strip backing reverses its wipe reveal as scene completes.",
      "duration": 0.45,
      "ease": "editorialSnap",
      "anchor": "right",
      "props": {
        "reveal": [[0, 1], [1, 0]],
        "x": [[0, 0], [1, 40]]
      }
    },
    "upwardVanish": {
      "intent": "Clean vertical dissipation ascending upward into the atmosphere.",
      "duration": 0.5,
      "ease": "cinematicOut",
      "props": {
        "y": [[0, 0], [1, -320]],
        "blur": [[0, 0], [1, 6]],
        "opacity": [[0, 1], [1, 0]]
      }
    }
  },

  "loop": {
    "cinematicHold": {
      "intent": "Barely perceptible camera-relative drift preserving visual life without disturbing reading.",
      "period": 4.0,
      "ease": "documentaryDrift",
      "fadeIn": 0.5,
      "props": {
        "y": [[0, 0], [0.5, -3], [1, 0]]
      }
    },
    "archivalPaperBoil": {
      "intent": "Subtle 2-step paper grain tremor giving a rich hand-printed feel.",
      "period": 0.6,
      "ease": "hold",
      "phase": "random",
      "fadeIn": 0.2,
      "props": {
        "rotZ": [[0, 0], [0.33, 0.4], [0.66, -0.3], [1, 0]]
      }
    },
    "breathingTitle": {
      "intent": "Gentle rhythmic scale pulse for long-held cinematic titles.",
      "period": 3.6,
      "ease": "documentaryDrift",
      "fadeIn": 0.8,
      "props": {
        "scale": [[0, 1], [0.5, 1.025], [1, 1]]
      }
    },
    "editorialSubtleFloat": {
      "intent": "Slow vertical pendulum hover for supporting cards and callouts.",
      "period": 3.0,
      "ease": "gentleSettle",
      "phaseStep": 0.15,
      "fadeIn": 0.4,
      "props": {
        "y": [[0, 0], [0.5, -6], [1, 0]],
        "rotZ": [[0, 0], [0.5, 0.8], [1, 0]]
      }
    },
    "dataPulse": {
      "intent": "Subtle opacity breathing on secondary data elements and metric labels.",
      "period": 2.2,
      "ease": "documentaryDrift",
      "fadeIn": 0.3,
      "props": {
        "opacity": [[0, 1], [0.5, 0.82], [1, 1]]
      }
    },
    "statSuspense": {
      "intent": "Suspended dimensional card hover in 3D space during narration.",
      "period": 2.8,
      "ease": "gentleSettle",
      "fadeIn": 0.4,
      "props": {
        "z": [[0, 0], [0.5, -20], [1, 0]],
        "rotY": [[0, 0], [0.5, 2], [1, 0]]
      }
    }
  },

  "camera": {
    "cinematicSlowPush": {
      "intent": "Deliberate documentary push toward the phrase deepening audience focus with soft distance drift.",
      "duration": 1.4,
      "ease": "cinematicOut",
      "from": { "zoom": 1.7, "rotX": -4 },
      "framing": { "zoom": 1.1 },
      "drift": { "dist": -120 },
      "motionBlur": 0.5
    },
    "heroLowAngleTrack": {
      "intent": "Low hero camera angle looking up at monumental text with gradual elevation push.",
      "duration": 1.3,
      "ease": "cinematicOut",
      "from": { "rotX": 25, "zoom": 1.5 },
      "framing": { "rotX": -14, "zoom": 1.1 },
      "drift": { "rotX": 2, "dist": -70 },
      "motionBlur": 0.6
    },
    "highAngleSurvey": {
      "intent": "Elevated geographic survey angle tilting downward to inspect structured concepts.",
      "duration": 1.2,
      "ease": "documentaryDrift",
      "from": { "rotX": -30, "ty": -400 },
      "framing": { "rotX": 14, "zoom": 1.08 },
      "drift": { "rotX": -2 },
      "motionBlur": 0.5
    },
    "documentaryPanLeft": {
      "intent": "Slow horizontal orbital sweep from the right revealing typography in perspective.",
      "duration": 1.5,
      "ease": "documentaryDrift",
      "from": { "rotY": 32 },
      "framing": { "rotY": 12, "rotX": 2, "zoom": 1.1 },
      "drift": { "rotY": -3, "dist": -50 },
      "motionBlur": 0.7
    },
    "documentaryPanRight": {
      "intent": "Mirror horizontal orbit from the left settling on clean reading baseline.",
      "duration": 1.5,
      "ease": "documentaryDrift",
      "from": { "rotY": -32 },
      "framing": { "rotY": -12, "rotX": -2, "zoom": 1.1 },
      "drift": { "rotY": 3, "dist": -50 },
      "motionBlur": 0.7
    },
    "precisionRackFocus": {
      "intent": "Transitions between conceptual depth planes by racking focus onto the new phrase.",
      "duration": 1.2,
      "ease": "editorialSnap",
      "rackFocus": { "delay": 0.4, "aperture": 3.2, "ease": "editorialSnap" },
      "from": { "zoom": 1.35 },
      "framing": { "rotY": -8, "zoom": 1.14, "aperture": 1.0 },
      "drift": { "dist": -60 },
      "motionBlur": 0.3
    },
    "editorialWhipCut": {
      "intent": "Rapid whip transit across shots with intense directional motion blur.",
      "duration": 0.5,
      "ease": "editorialSnap",
      "from": { "tx": -1800, "rotY": 28 },
      "framing": { "rotY": -10, "zoom": 1.08 },
      "motionBlur": 1.8
    },
    "subtleDutchTilt": {
      "intent": "Restrained Dutch angle establishing investigative tone for questions and inquiries.",
      "duration": 1.0,
      "ease": "cinematicOut",
      "from": { "rotZ": 18 },
      "framing": { "rotZ": -5, "rotY": 8, "zoom": 1.1 },
      "drift": { "rotZ": 1.5 },
      "motionBlur": 0.6
    },
    "vertigoSubtlePush": {
      "intent": "Refined dolly zoom subtly expanding background FOV while locking foreground size.",
      "duration": 1.4,
      "ease": "documentaryDrift",
      "from": { "zoom": 2.0 },
      "props": {
        "fov": [[0, 0], [0.5, 18], [1, 0]],
        "zoom": [[0, 1], [0.5, 0.85], [1, 1]]
      },
      "framing": { "rotY": 6, "zoom": 1.1 },
      "drift": { "fov": -2 },
      "motionBlur": 0.4
    },
    "overviewPullback": {
      "intent": "Camera pulls back smoothly to establish broad diorama context of all demonstrated concepts.",
      "duration": 1.8,
      "ease": "documentaryDrift",
      "framing": { "rotY": -10, "rotX": 8, "zoom": 0.95 },
      "drift": { "dist": 140 },
      "motionBlur": 0.4
    },
    "statFocusPunch": {
      "intent": "Rapid punch zoom directly onto numeric data for instant authority.",
      "duration": 0.45,
      "ease": "editorialSnap",
      "from": { "zoom": 2.2 },
      "framing": { "zoom": 1.05 },
      "drift": { "dist": -50 },
      "motionBlur": 1.2
    },
    "timelineGlideTrack": {
      "intent": "Smooth lateral camera dolly tracking chronologically along historical sequence.",
      "duration": 1.4,
      "ease": "documentaryDrift",
      "from": { "tx": -1200 },
      "framing": { "zoom": 1.1 },
      "drift": { "tx": 80 },
      "motionBlur": 0.6
    }
  },

  "staging": {
    "timelineLinear": {
      "intent": "Sequential horizontal spatial stepping along historical or procedural timelines.",
      "type": "linear",
      "step": { "x": 1450, "z": -180 },
      "jitter": { "y": 60, "rotZ": 2 }
    },
    "editorialZigzag": {
