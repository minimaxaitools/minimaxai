{
  "_about": "Sample kinetic explainer on a neutral placeholder topic (how a paper plane flies). Every schema feature is used at least once — see the _demo notes. Swap only this file to make a new video.",
  "meta": {
    "title": "How a Paper Plane Flies",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "seed": "paper-plane-v1",
    "pace": 1
  },
  "theme": "paperWhimsy",
  "defaults": {
    "_demo": "Content-level defaults override the theme defaults for this video only.",
    "exit": "fadeBack",
    "idle": "paperBoil"
  },
  "scenes": [
    {
      "id": "title",
      "_demo": "Arc layout, manual JSON camera keyframes, word-level split, confetti background, iris transition.",
      "background": "confettiParty",
      "staging": "flipbook",
      "layout": "arc",
      "transition": "iris",
      "camera": {
        "mode": "additive",
        "keyframes": [
          {
            "at": 0,
            "rotY": -18,
            "rotX": 8,
            "zoom": 1.4
          },
          {
            "at": "shot:1",
            "rotY": 10,
            "rotX": -4,
            "zoom": 1.1,
            "ease": "glide"
          },
          {
            "at": "end",
            "rotY": 0,
            "rotX": 0,
            "zoom": 1.0,
            "ease": "glide"
          }
        ]
      },
      "beats": [
        {
          "text": "[How](small hand) a [paper plane](huge accent sparkle) | really flies",
          "split": "manual",
          "entry": "dropBounce",
          "emphasis": "wiggle"
        },
        {
          "text": "[a 60-second explainer](hand label)",
          "layout": "centered",
          "role": "hand",
          "entry": "typewriter",
          "speed": 1.2
        }
      ]
    },
    {
      "id": "forces",
      "_demo": "Ring staging (camera orbits), strips, icon/badge/burst tags, legacy annotation nodes attached to a beat, per-beat camera moves.",
      "title": "Four forces",
      "background": "paperStack",
      "staging": "ring",
      "layout": "lockupStrips",
      "transition": {
        "preset": "paperWipe",
        "duration": 1.1,
        "color": "@accent2"
      },
      "beats": [
        "Every flight is a tug-of-war between [four forces.](em underline)",
        {
          "text": "[Lift](big accent2 icon:cloud) pushes up, | [weight](big icon:bolt,left) pulls down.",
          "cameraMoves": [
            "orbitLeft",
            "craneDown"
          ]
        },
        {
          "text": "[Thrust](big accent icon:rocket) comes from your throw… | [drag](big boil) tries to stop it.",
          "entry": "slideSkew",
          "annotations": [
            {
              "typeKey": "annotationBadge",
              "target": "Thrust",
              "badgeText": "3"
            },
            {
              "typeKey": "annotationCallout",
              "target": "drag",
              "label": "air friction",
              "connectorType": "curve",
              "connectorEnd": "dot"
            }
          ]
        }
      ]
    },
    {
      "id": "numbers",
      "_demo": "Counters with prefix/suffix and ranges, highlight + circle, blueprint background, stack staging (camera dollies through planes), fly-through transition, scene palette override.",
      "background": "blueprint",
      "staging": "stack",
      "layout": "centered",
      "transition": "flyThrough",
      "palette": {
        "accent": "#E4572E"
      },
      "beats": [
        {
          "text": "We folded [1,200](counter huge accent) planes",
          "entry": "zoomThrough"
        },
        {
          "text": "[87%](counter:40-87 huge accent2) flew farther | with one [sharp crease.](highlight circle)",
          "entry": "popUpBook"
        },
        {
          "text": "Longest glide: [18.6m](counter:0-18.6,1 big) | [wow](stamp:RECORD burst)",
          "cameraMoves": [
            "snapZoom",
            "dutchRoll"
          ]
        }
      ]
    },
    {
      "id": "myth",
      "_demo": "Strike-through, in:/out:/fx: tags, sticker words, arrow with a label, bracket quote, shapeWipe, beat exit mode, outro pull-back reveal, time-stretched duration.",
      "background": "sunburst",
      "staging": "zigzag",
      "exitMode": "scene",
      "outro": "pullBackReveal",
      "duration": 11,
      "transition": "fold",
      "beats": [
        {
          "text": "Myth: [heavier paper](strike) always wins.",
          "layout": "lockup",
          "entry": "foldDown"
        },
        {
          "text": "[Nope.](huge accent in:stampIn fx:shake shapeWipe)",
          "split": "sentence"
        },
        {
          "text": "Balance beats [weight](sticker arrow:the_real_secret,bottomLeft) every time.",
          "layout": "stickers"
        },
        {
          "text": "[“Fold it slow, throw it gentle.”](quote)",
          "layout": "handNote",
          "entry": "typewriter"
        }
      ]
    },
    {
      "_demo": "BACKWARD COMPATIBILITY — a scene made only of existing D3 Annotation Studio nodes (typeKey/title/label/color/fonts/badgeText). The engine expands each node into beats and maps typeKey to kinetic supplements.",
      "id": "legacy",
      "background": "quietPaper",
      "transition": "shutter",
      "annotations": [
        {
          "typeKey": "annotationBadge",
          "x": 120,
          "y": 90,
          "title": "Fold the nose",
          "label": "• Crease it sharp\n• Keep both wings even\n• Tip slightly up",
          "badgeText": "1",
          "color": "#2F7BD9",
          "titleFont": "Baloo 2",
          "titleFontWeight": 800
        },
        {
          "typeKey": "annotationCalloutCircle",
          "x": 120,
          "y": 260,
          "title": "Throw level",
          "label": "Aim at the horizon, not the sky.",
          "color": "#FF5A4E",
          "motion": {
            "entry": "tumbleIn",
            "camera": "rackFocus",
            "tags": "wow"
          }
        }
      ]
    },
    {
      "id": "guides",
      "_demo": "Pattern guideline primitives (the same kinds your custom patterns return) drawn on as a kinetic backdrop; phrase split, per-beat staging; inline background object; matchCut transition.",
      "background": {
        "color": "@paper",
        "layers": [
          {
            "type": "dots",
            "depth": 2400,
            "spacing": 64,
            "radius": 3,
            "opacity": 0.16,
            "color": "@ink"
          }
        ]
      },
      "staging": "spiral",
      "transition": "matchCut",
      "guideSize": {
        "w": 800,
        "h": 500
      },
      "guides": [
        {
          "kind": "path",
          "d": "M 60 420 Q 300 60 740 140",
          "stroke": "#2F7BD9",
          "strokeWidth": 3,
          "strokeDasharray": "10,8"
        },
        {
          "kind": "circle",
          "cx": 740,
          "cy": 140,
          "r": 26,
          "stroke": "#FF5A4E",
          "strokeWidth": 3
        },
        {
          "kind": "line",
          "x1": 40,
          "y1": 460,
          "x2": 780,
          "y2": 460,
          "stroke": "#2A2733",
          "strokeWidth": 2
        },
        {
          "kind": "text",
          "x": 400,
          "y": 490,
          "text": "GLIDE PATH",
          "fontSize": 18,
          "textAnchor": "middle",
          "fill": "#2A2733"
        }
      ],
      "beats": [
        {
          "text": "A good glide follows a long, lazy curve, and lands softly.",
          "split": "phrase",
          "entry": "anticipateRise",
          "cameraMoves": [
            "floatOver",
            "orbitRight",
            "tiltUp"
          ]
        },
        {
          "text": "[Faster](accent in:whipIn) is not [farther.](underlineWavy)",
          "staging": "zigzag",
          "cameraMoves": [
            "whipPan",
            "dollyZoom"
          ]
        }
      ]
    },
    {
      "id": "explicit-visuals",
      "_demo": "Hand-authored visuals (no Auto-Director needed): map with your annotation typeKeys as markers + a route, SVG with per-part rules, and a chart.",
      "background": "paperStack",
      "transition": "flyThrough",
      "beats": [
        {
          "text": "Paper was invented in China, then travelled west along the Silk Road.",
          "visual": {
            "type": "map",
            "focus": "CN",
            "places": [
              {
                "query": "Xi'an",
                "label": "Chang'an",
                "typeKey": "annotationBadge",
                "badgeText": "1"
              },
              {
                "typeKey": "annotationCalloutCircle",
                "label": "Samarkand",
                "lat": 39.654,
                "lon": 66.975
              },
              {
                "query": "Baghdad",
                "typeKey": "annotationCallout",
                "title": "First paper mill",
                "label": "794 CE",
                "dx": -90,
                "dy": -70
              }
            ],
            "routes": [
              [
                "Xi'an",
                "Baghdad"
              ]
            ],
            "highlight": [
              "UZ",
              "IQ"
            ]
          }
        },
        {
          "text": "A plant turns sunlight into sugar.",
          "visual": {
            "type": "media",
            "asset": "plant",
            "svg": {
              "mode": "strokeThenFill",
              "animate": [
                {
                  "select": "#sunlight",
                  "loop": "pulse"
                },
                {
                  "select": ".leaf",
                  "loop": "wiggle"
                }
              ]
            }
          }
        },
        {
          "text": "Glide time by paper-plane design.",
          "visual": {
            "type": "chart",
            "chart": "column",
            "title": "Glide time",
            "data": [
              {
                "label": "Dart",
                "value": 4.2
              },
              {
                "label": "Glider",
                "value": 7.8
              },
              {
                "label": "Stunt",
                "value": 3.1
              },
              {
                "label": "Nakamura",
                "value": 6.5
              }
            ],
            "decimals": 1,
            "suffix": " s"
          }
        }
      ]
    },
    {
      "id": "outro",
      "_demo": "Word-by-word split, theme override for one scene, emphasis chain, bullet-free ending (last scene has no transition).",
      "theme": {
        "palette": {
          "paper": "#FFF4E0"
        }
      },
      "background": "confettiParty",
      "staging": "scatter3d",
      "beats": [
        {
          "text": "Fold. Throw. [Wonder.](em sparkle idea)",
          "split": "word",
          "emphasis": [
            "jump",
            "pulse"
          ],
          "entry": "squashStretch"
        }
      ]
    }
  ]
}