{
  "$schema": "../presets.schema.json",
  "pack": {
    "name": "explainer-pro",
    "version": "1.0.0",
    "author": "Kinetic Studio example",
    "intent": "Advanced explainer pack: cinematic eases, 3D card and page-turn entries, character emphasis, documentary camera moves, classroom chalkboard theme and richer sentence recipes. Adds to presets.motion.json — nothing is removed."
  },
  "easings": {
    "cinematicOut": {
      "intent": "Very long, soft deceleration for hero arrivals.",
      "curve": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "rubbery": {
      "intent": "Loose rubber spring with two visible bounces.",
      "curve": {
        "type": "spring",
        "stiffness": 140,
        "damping": 6
      }
    },
    "snapBack": {
      "intent": "Quick overshoot that snaps back hard.",
      "curve": [
        0.5,
        2.2,
        0.4,
        0.9
      ]
    },
    "heavyLand": {
      "intent": "Heavy object landing: fast fall, tiny bounce.",
      "curve": {
        "type": "spring",
        "stiffness": 520,
        "damping": 22,
        "mass": 1.4
      }
    },
    "lazy": {
      "intent": "Slow, dreamy ease for reflective lines.",
      "curve": [
        0.6,
        0,
        0.2,
        1
      ]
    }
  },
